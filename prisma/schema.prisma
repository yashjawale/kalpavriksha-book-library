// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Book {
  isbn                String   @id
  title               String
  author              String?
  publisher           String?
  totalStock          Int      @default(1)
  needsBarcodeSticker Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  loans    Loan[]
  bookTags BookTag[]

  @@map("books")
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())

  // Relations
  bookTags BookTag[]

  @@map("tags")
}

model BookTag {
  bookIsbn  String
  tagId     Int
  createdAt DateTime @default(now())

  // Relations
  book Book @relation(fields: [bookIsbn], references: [isbn], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookIsbn, tagId])
  @@index([bookIsbn])
  @@index([tagId])
  @@map("book_tags")
}

model User {
  // Use email as the primary key
  email String  @id
  name  String?

  // Relations
  loans Loan[]

  @@map("users")
}

model Loan {
  id         Int       @id @default(autoincrement())
  bookIsbn   String
  userEmail  String
  borrowedAt DateTime  @default(now())
  returnedAt DateTime?
  dueDate    DateTime?

  // Relations - linked via email string directly
  book     Book @relation(fields: [bookIsbn], references: [isbn])
  borrower User @relation(fields: [userEmail], references: [email])

  @@index([bookIsbn])
  @@index([userEmail])
  @@index([returnedAt])
  @@index([dueDate])
  @@index([borrowedAt])
  @@map("loans")
}

model CapturedBook {
  id            Int      @id @default(autoincrement())
  frontImage    String
  backImage     String
  isbn          String?
  title         String?
  author        String?
  publisher     String?
  tagIds        String?  // JSON string
  status        String   @default("PENDING") // PENDING, PROCESSED
  isDuplicate   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("captured_books")
}
