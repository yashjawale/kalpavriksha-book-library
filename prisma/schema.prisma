// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Book {
  isbn        String   @id
  title       String
  totalStock  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  loans       Loan[]

  @@map("books")
}

model User {
  // Use email as the primary key
  email String @id 
  name  String?
  
  // Relations
  loans Loan[]

  @@map("users")
}

model Loan {
  id         Int       @id @default(autoincrement())
  bookIsbn   String
  userEmail  String
  borrowedAt DateTime  @default(now())
  returnedAt DateTime?

  // Relations - linked via email string directly
  book       Book      @relation(fields: [bookIsbn], references: [isbn])
  borrower   User      @relation(fields: [userEmail], references: [email])

  @@index([bookIsbn])
  @@index([userEmail])
  @@map("loans")
}